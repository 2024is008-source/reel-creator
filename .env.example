# ============================================================================
# AI Cinematic Motivational Video Studio — Environment Configuration Example
# Copy this file to `.env` in the project root (or `local-tts/.env`)
# Never commit your real API key or expose GEMINI_API_KEY in frontend code.
# ============================================================================

# 1. Google Gemini API (Server-side only — used for Script, Story, Captions,
#    Narration text, Visual Bible, and Scene Image Prompts)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Google Flow / Nano Banana Browser Automation (Direct-CDP + Playwright)
GOOGLE_FLOW_URL=https://labs.google/fx/tools/flow
FLOW_BROWSER_PROFILE_DIR=./services/.browser_profile
FLOW_BROWSER_MODE=direct-cdp
FLOW_CDP_PORT=9222
FLOW_EXPECTED_ACCOUNT=
FLOW_HEADLESS=false

# 3. Local Offline Piper TTS Service
LOCAL_TTS_PORT=5005
PIPER_VOICES_DIR=./local-tts/voices
